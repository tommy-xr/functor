//! Lightmap tools. `unwrap` gives a static model's data a second UV set
//! (`uvs2`) for a lightmap baked in Blender or with `functor bake`. Edge-adjacent
//! triangles facing the same way (within ~6°) become charts, split wherever
//! laid flat they would overlap; each is laid flat at `texelsPerMeter`,
//! turned to its smallest rectangle, and packed like `Texture.atlas` into one
//! power-of-two square.
//!
//! ```
//! let unwrapped = Lightmap.unwrap(roomData, { texelsPerMeter: 16.0, padding: 2.0, maxSize: 1024.0 })
//! let room = Model.static({ unwrapped.mesh with
//!   lightmap: Option.Some({ texture: baked, scale: 1.0, floor: Color.rgb(0.0, 0.0, 0.0) }) })
//! ```

/// `texelsPerMeter`: lightmap resolution, the same on every surface.
/// `padding`: texels kept free around each chart, so filtering never reaches
/// a neighbour (a bake fills them with copies of the chart's edge).
/// `maxSize`: the largest atlas side, a power of two up to 4096.
type options = { texelsPerMeter: float, padding: float, maxSize: float }

/// `mesh` is the input data with `uvs2` filled in and its other per-vertex
/// fields copied to a new vertex set: a vertex on a seam between charts
/// needs a lightmap UV in each, so it is duplicated (an indexed 8-vertex
/// cube comes back with 24), and vertices no triangle uses are dropped.
/// Triangles keep their order, so `groups` carry over; `lightmap` becomes
/// `Option.None`, since one baked for the old `uvs2` no longer fits. `source`
/// is u32 per new vertex: the input vertex it copies. The atlas is `width` ×
/// `height` texels.
type unwrapped = { mesh: Model.staticData, source: Bytes.t, width: float, height: float }

/// Lightmap UVs for static model data, validated like `Model.static`. The
/// same data gives the same bytes. Charts that don't fit `maxSize` are an
/// error: lower `texelsPerMeter`. Curved surfaces become one chart per face
/// (a 16-sided cylinder has 18 charts).
let unwrap : (Model.staticData, options) => unwrapped

/// One lightmap for `functor bake`, which reads a top-level
/// `let bakes : List<Lightmap.bakeJob>`, unwraps each `mesh` (its `uvs2` are
/// replaced) and writes `<name>.png` (linear light, RGBA8) and
/// `<name>.mesh.bin` (the unwrapped mesh) for the game to load:
///
/// ```
/// let bakes = [{ name: "room", mesh: roomData, lights: roomLights }]
/// let room = Model.static({ Lightmap.readMesh(File.bytes("baked/room.mesh.bin")) with
///   groups: roomData.groups,
///   lightmap: Option.Some({ texture: Texture.fromPng(File.bytes("baked/room.png"), Texture.Linear),
///     scale: 1.0, floor: Color.rgb(0.0, 0.0, 0.0) }) })
/// ```
///
/// The baked texels hold light, not colour: the shader multiplies in each
/// group's texture. Lights work as at runtime (same falloff; only
/// `castShadows` lights cast shadows); ambient light is darkened where
/// geometry is near (occlusion). Mark the same lights `Light.baked` in the
/// game so lightmapped surfaces don't get them twice. Light above 1 clips:
/// lower it and raise the lightmap's `scale`.
type bakeJob = { name: string, mesh: Model.staticData, lights: List<Light.t> }

/// The mesh in a `.mesh.bin` that `functor bake` wrote: `Model.staticData`
/// with its `uvs2`, groups without textures (the triangles keep their order,
/// so the original `groups` fit), and no lightmap. Bad bytes are an error.
let readMesh : (Bytes.t) => Model.staticData
