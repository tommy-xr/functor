//! Commands returned beside a model and performed by the runtime.
//!
//! Results are converted into game messages and folded back through `update`.
//! Effects remain outside the game's pure functional core.

/// An opaque effect command.
type t = host

/// Produce no command.
let none : () => t
/// Read the current Unix time in seconds and tag the result as a message.
let now : ((float) => 'msg) => t
/// Generate a random float in `0..1` and tag it as a message.
let random : ((float) => 'msg) => t
/// Combine effects to be performed together.
let batch : (List<t>) => t
/// Send text over a live connection by connection ID.
let send : (float, string) => t
/// Send a plain-data value over a live connection.
///
/// The peer receives `Net.Data(id, value)`. Functions and opaque host values
/// cannot be sent.
let sendMsg : (float, 'a) => t
/// Perform an HTTP GET and tag its `Net.HttpResponse` as a message.
let httpGet : (string, (Net.HttpResponse) => 'msg) => t
/// Perform an HTTP POST with a text body and tag its response as a message.
let httpPost : (string, string, (Net.HttpResponse) => 'msg) => t
/// Play a non-spatial sound once.
let play : (Asset.Sound) => t
/// Play a spatial sound once at a world position.
let playAt : (Asset.Sound, Vec3.t) => t
/// Play a sound once and deliver a message when playback finishes.
///
/// The completion message is native-only; on wasm the sound plays but the
/// message is not delivered, so do not gate game progress on it.
let playThen : (Asset.Sound, 'msg) => t
/// Vibrate one XR controller once: `amplitude` from 0 (off) to 1 (full)
/// for `duration`, up to 5 s (`0ms` = the device's shortest pulse).
///
/// Fire-and-forget: nothing comes back through `update`. An amplitude outside
/// `0..1` or a duration outside `0..5s` is a teaching error. Per frame each
/// hand performs one pulse, the strongest (ties go to the longer); the rest
/// count as dropped. On Quest it drives the controller's haptic output;
/// desktop and headless have no actuator and only count it, and web ignores
/// it. `GET /state`'s `haptics` reports `{sent, dropped, recent}`. Fork,
/// ghost, seek, rewind and hot reload never re-fire one.
///
/// ```functor
/// let grabbed = (model) => (model, Effect.haptic(Xr.Right, 0.6, 30ms))
/// ```
let haptic : (Xr.hand, float, Time.t) => t
/// Begin loading a model or texture before it is referenced by `draw`.
///
/// The imperative prefetch; the declarative default is simply that `draw`
/// references the asset. The parameter is generic, but only an `Asset.Model`
/// or `Asset.Texture` is accepted: an `Asset.Sound` is a teaching error (a
/// sound decodes at play time and has no pending state), and a bare path
/// string is rejected toward `Asset.model` / `Asset.texture` like any other
/// asset consumer. `preloadThen` takes the same values.
let preload : ('asset) => t
/// Preload an asset and deliver a message when the load settles.
///
/// Settlement includes success and failure; `Sub.assets` reports which assets
/// failed. Preloads count toward `Sub.assets` totals, and unlike `playThen`'s
/// completion message this one is delivered on wasm too.
let preloadThen : ('asset, 'msg) => t
