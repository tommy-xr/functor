//! Per-copy placement for `Scene.instanced`.
//!
//! Build one `Instance.t` per copy — where it sits, how it is scaled and
//! rotated, and an optional color tint — then hand the list to
//! `Scene.instanced`, which stamps its template scene once per instance.
//!
//! Instances are CHANNELS, not free-form transform chains: the copy's
//! transform always applies scale, then rotation, then translation, whatever
//! order the combinators were piped in. Combinators compose within their own
//! channel — rotations multiply (the outer pipe applies last, like
//! `Scene.rotate*`), scales multiply componentwise, and tints multiply
//! componentwise.

/// One copy's placement: position, rotation, per-axis scale, and tint.
type t = host

/// Start an instance at `position`, with no rotation, unit scale, and no
/// tint.
let at : (Vec3.t) => t

/// Multiply the instance's scale uniformly.
let scale : (float, t) => t

/// Multiply the instance's per-axis scale componentwise.
let scaleXYZ : (float, float, float, t) => t

/// Rotate the instance about the X axis; piped later means applied later.
let rotateX : (Angle.t, t) => t

/// Rotate the instance about the Y axis; piped later means applied later.
let rotateY : (Angle.t, t) => t

/// Rotate the instance about the Z axis; piped later means applied later.
let rotateZ : (Angle.t, t) => t

/// The flat fast path: position, yaw, and per-axis scale in ONE call.
///
/// Exactly `Instance.at(position) |> Instance.scaleXYZ(sx, sy, sz)
/// |> Instance.rotateY(rotationY)`, minus the per-copy builder-call overhead —
/// reach for it when a large per-frame field makes construction cost visible.
/// Compose further channels (another rotation axis, `Instance.tint`) on top.
let trs : (Vec3.t, Angle.t, float, float, float) => t

/// Multiply the copy's material colors by `color` — a per-instance tint over
/// the template's material, not a second material system. Tints compose by
/// multiplying; white is the identity. The tint is RGB only — a copy's alpha
/// always comes from the template's material. A bare `Scene.model` template
/// has no material colors to multiply, so tint has no effect there (exactly
/// as in the stamped group).
let tint : (Color.t, t) => t

/// Where a ray first meets an instance's box (see `raycast`).
type hit = { index: float, point: Vec3.t, normal: Vec3.t, distance: float }

/// The nearest instance box a ray meets, or `Option.None` — picking among
/// thousands of boxes in one call, with no physics bodies.
///
/// Each instance's box is the unit cube (`-0.5..0.5` on each axis) under the
/// instance's scale, rotation and position: exactly what an instanced
/// `Scene.cube()` draws, oriented boxes included. Other templates are picked
/// by that same box. The ray is in the instances' space — the space of the
/// `Scene.instanced` node (world space, unless the node is transformed).
///
/// - `index` is the instance's position in the list; `distance` runs along
///   the ray's normalized direction, in the instances' units; `normal` is the
///   entered face's outward unit normal.
/// - A ray that starts inside (or on) a box hits it at distance 0, at the
///   origin, with `normal` the reversed direction.
/// - A ray parallel to a face pair (within 1e-12 of it) hits only when it
///   runs between them; a zero-size axis is a flat box, hit when the ray
///   crosses it.
/// - Equal distances go to the lower index; a ray through an edge or corner
///   takes the face of the box's lowest local axis (X, then Y, then Z).
/// - A zero or non-finite direction hits nothing, and a box with non-finite
///   data is never hit.
///
/// Keep the list the same value you draw (the model, or a top-level def) and
/// the call converts nothing. It tests every box, rejecting most by a bounding
/// sphere first: a few nanoseconds a box on a desktop.
///
/// ```functor
/// let hovered = Camera3D.toWorldRay(snapshot.mouse, camera)
///   |> Option.bind((ray) => Instance.raycast(ray, model.towers))
///   |> Option.map((hit) => hit.index)
/// ```
let raycast : (Camera3D.ray, List<t>) => Option.t<hit>
