//! Binary data for decoders: an immutable `Bytes.t` (usually from
//! `File.bytes`) and readers for its numbers and text. Offsets and lengths are
//! byte counts — whole numbers ≥ 0, relative to the bytes given (a slice starts
//! at 0, and so do its errors' offsets). Readers return a `Result`, so a decoder can
//! report or recover from short or malformed data; `Binary.require` turns an
//! error into a located one.
//!
//! ```
//! let data = File.bytes("data/model.bin")
//! let count = Bytes.u32le(4.0, data) |> Binary.require
//! ```

/// An immutable sequence of bytes; slices share storage.
type t = host

/// The number of bytes.
let length : (t) => float
/// `length` bytes from `start`, sharing storage.
let slice : (float, float, t) => Result.t<t, Binary.error>
/// Whether two byte sequences hold the same bytes.
let equals : (t, t) => bool
/// `length` bytes from `offset` as Latin-1 text (one character per byte).
let latin1 : (float, float, t) => Result.t<string, Binary.error>
/// `length` bytes from `offset` as UTF-8 text.
let utf8 : (float, float, t) => Result.t<string, Binary.error>
/// The unsigned byte at `offset`.
let u8 : (float, t) => Result.t<float, Binary.error>
/// The signed byte at `offset`.
let i8 : (float, t) => Result.t<float, Binary.error>
/// The unsigned 16-bit little-endian integer at `offset`.
let u16le : (float, t) => Result.t<float, Binary.error>
/// The unsigned 16-bit big-endian integer at `offset`.
let u16be : (float, t) => Result.t<float, Binary.error>
/// The signed 16-bit little-endian integer at `offset`.
let i16le : (float, t) => Result.t<float, Binary.error>
/// The signed 16-bit big-endian integer at `offset`.
let i16be : (float, t) => Result.t<float, Binary.error>
/// The unsigned 32-bit little-endian integer at `offset`.
let u32le : (float, t) => Result.t<float, Binary.error>
/// The unsigned 32-bit big-endian integer at `offset`.
let u32be : (float, t) => Result.t<float, Binary.error>
/// The signed 32-bit little-endian integer at `offset`.
let i32le : (float, t) => Result.t<float, Binary.error>
/// The signed 32-bit big-endian integer at `offset`.
let i32be : (float, t) => Result.t<float, Binary.error>
/// The 32-bit little-endian float at `offset`.
let f32le : (float, t) => Result.t<float, Binary.error>
/// The 32-bit big-endian float at `offset`.
let f32be : (float, t) => Result.t<float, Binary.error>
/// The 64-bit little-endian float at `offset`.
let f64le : (float, t) => Result.t<float, Binary.error>
/// The 64-bit big-endian float at `offset`.
let f64be : (float, t) => Result.t<float, Binary.error>

/// The parts joined into one.
let concat : (List<t>) => t
/// Text as UTF-8 bytes.
let fromUtf8 : (string) => t
/// Text as Latin-1 bytes (one byte per character; others are an error).
let fromLatin1 : (string) => t
/// Unsigned bytes; each number must be a whole number from 0 to 255.
let fromU8 : (List<float>) => t
/// Signed bytes.
let fromI8 : (List<float>) => t
/// Unsigned 16-bit little-endian integers.
let fromU16le : (List<float>) => t
/// Unsigned 16-bit big-endian integers.
let fromU16be : (List<float>) => t
/// Signed 16-bit little-endian integers.
let fromI16le : (List<float>) => t
/// Signed 16-bit big-endian integers.
let fromI16be : (List<float>) => t
/// Unsigned 32-bit little-endian integers.
let fromU32le : (List<float>) => t
/// Unsigned 32-bit big-endian integers.
let fromU32be : (List<float>) => t
/// Signed 32-bit little-endian integers.
let fromI32le : (List<float>) => t
/// Signed 32-bit big-endian integers.
let fromI32be : (List<float>) => t
/// 32-bit little-endian floats (rounded from the numbers).
let fromF32le : (List<float>) => t
/// 32-bit big-endian floats.
let fromF32be : (List<float>) => t
/// 64-bit little-endian floats.
let fromF64le : (List<float>) => t
/// 64-bit big-endian floats.
let fromF64be : (List<float>) => t
