//! Printable solids: build a part in code, then `functor export` it as STL.
//!
//! Units are millimetres and Z is up — the 3D-printing convention, not the
//! scene's metres and Y-up. Every primitive is closed and outward-facing. Bind
//! the result as `let part = …` and run `functor export -o part.stl`. A file
//! that is only a `part` runs in a default viewer (`functor run`: drag to orbit,
//! scroll to zoom) — see `<stdlib>/PartViewer.fun` to customize it. Screw
//! holes, nut traps, insert and magnet pockets: `<stdlib>/Hardware.fun`;
//! threads: `<stdlib>/Thread.fun`; dowels and keys for split parts:
//! `<stdlib>/Connector.fun`; print tolerances: `<stdlib>/Fit.fun`.
//!
//! ```
//! let part = Solid.group([
//!   Solid.box(40.0, 40.0, 4.0),
//!   Solid.cylinder(6.0, 12.0) |> Solid.translate(Vec3.make(0.0, 0.0, 8.0)),
//! ])
//! ```

/// An opaque printable solid.
type t = host

/// The axis-aligned box enclosing a solid, in millimetres.
type bounds = { min: Vec3.t, max: Vec3.t }

/// A box `width` (X) by `depth` (Y) by `height` (Z), centered on the origin.
let box : (float, float, float) => t
/// A Z-axis cylinder of `radius` and `height`, centered on the origin.
let cylinder : (float, float) => t
/// A Z-axis cone from `bottomRadius` at the base to `topRadius` at the top,
/// `height` tall, centered on the origin. One radius may be 0 for a point;
/// two different radii make a frustum (a countersink, a chamfer).
let cone : (float, float, float) => t
/// An ISO metric screw thread (60° basic profile) of major `diameter` and
/// `pitch` along Z, from z = 0 to `length`, grown by `offset` mm all over its
/// surface (negative shrinks; a flat that closes turns sharp). It is a bolt's
/// thread, or — subtracted from a part — a nut's. `<stdlib>/Thread.fun` picks
/// sizes and print fits.
let thread : (float, float, float, float) => t
/// A sphere of `radius`, centered on the origin.
let sphere : (float) => t

/// Sweep a 2D sketch up from z = 0 to `height` mm into a solid.
let extrude : (float, Sketch.t) => t
/// How `extrudeWith` finishes an edge, all round the outline: `Sharp`, a 45°
/// `Bevel` (chamfer) reaching `size` mm down the wall and in from it, or a
/// `Round` (fillet) of `radius` mm.
type edge = | Sharp | Bevel(size: float) | Round(radius: float)
/// An extrusion's top and bottom edge finishes.
type edges = { top: edge, bottom: edge }
/// `extrude`, with its top and bottom edges bevelled or rounded — exact, not
/// stepped. In from a wall by `d`, the edge's cross-section is
/// `Sketch.offset(-d)` of the sketch: convex corners stay sharp, concave ones
/// round. Top and bottom may reach at most the height together, and only as
/// far in as the sketch shrinks in one piece: every part must be over twice
/// the edge's size across. The error names the most that fits.
///
/// ```
/// let bezel = Sketch.roundedRect(200.0, 130.0, 18.0)
///   |> Solid.extrudeWith({ top: Solid.Bevel(2.5), bottom: Solid.Round(1.0) }, 6.0)
/// ```
let extrudeWith : (edges, float, Sketch.t) => t

/// Move a solid by an offset in millimetres; the solid is last for piping.
let translate : (Vec3.t, t) => t
/// Rotate a solid about the X axis through the origin.
let rotateX : (Angle.t, t) => t
/// Rotate a solid about the Y axis through the origin.
let rotateY : (Angle.t, t) => t
/// Rotate a solid about the Z axis through the origin.
let rotateZ : (Angle.t, t) => t
/// Scale a solid uniformly about the origin by a positive factor.
let scale : (float, t) => t

/// Merge solids into one closed solid (at least one): overlapping and
/// touching pieces fuse. A boolean is evaluated once, at its own scale —
/// scale parts before combining them, not after.
let union : (List<t>) => t
/// Cut `cut` out of a solid; the solid is last for piping, e.g.
/// `plate |> Solid.subtract(hole)`.
let subtract : (t, t) => t
/// Keep only where a solid overlaps `other`; the solid is last for piping.
let intersect : (t, t) => t

/// The convex hull of solids (at least one): the smallest convex solid
/// around them all, like shrink-wrap. Two spheres make a capsule; a box and a
/// smaller box above it make a tapered block.
let hull : (List<t>) => t
/// Grow a solid by `distance` mm all over, or shrink it if negative: faces
/// move along their normals, and the edges and corners that move apart are
/// filled round (outside ones when growing, inside ones when shrinking).
/// Shrinking a part away (nowhere thicker than 2 × |distance|) is an error.
/// Like a boolean, evaluated once at its own scale. Boxes, cylinders and
/// spheres take milliseconds (a 20 mm sphere grown 5 mm: half a second);
/// concave or pointed solids 2–30 ms per triangle, more for bigger distances
/// (seconds for a holed plate), so bind the result once at the top level and
/// offset simple parts before combining them.
let offset : (float, t) => t
/// Round a solid's outside edges and corners to `radius` mm, keeping its
/// size: shrink by `radius`, then grow back (a morphological opening). Inside
/// edges stay sharp, and features under 2 × `radius` thick (fins, thin walls)
/// vanish. Unlike `extrudeWith`'s `Solid.Round(radius)`, which finishes an
/// extrusion's top and bottom edges exactly, this rounds every outside edge of
/// any solid, faceted; it costs what `offset` does, twice.
///
/// ```
/// let knob = Solid.cylinder(10.0, 8.0) |> Solid.round(1.5)
/// ```
let round : (float, t) => t

/// A plane: the points `p` where `Vec3.dot(normal, p) == offset`, in mm.
/// Normal and offset scale together: `{ normal: Vec3.make(0.0, 0.0, 2.0),
/// offset: 10.0 }` is z = 5.
type plane = { normal: Vec3.t, offset: float }
/// Cut a solid in two along a plane: `(above, below)`, where `above` is the
/// side the normal points to. Each half is closed by its cut face, in place.
/// A plane that misses the solid or only touches it fails when the halves
/// are measured or exported. `<stdlib>/Connector.fun` adds dowels and keys
/// and lays halves flat for printing.
let split : (plane, t) => (t, t)
/// Keep the side of a solid that a plane's normal points to, closed by the
/// cut face — a half-space, no huge box needed: `{ normal: Vec3.make(0.0,
/// 0.0, 1.0), offset: 2.0 }` keeps z ≥ 2. A plane past the solid keeps all
/// of it, or nothing (an empty solid, which `check` reports). Like a boolean,
/// evaluated once at its own scale.
let trim : (plane, t) => t
/// The mirror image of a solid through a plane: `{ normal: Vec3.make(1.0,
/// 0.0, 0.0), offset: 0.0 }` turns x into -x. Faces stay outward.
let mirror : (plane, t) => t

/// Where to put a part: an origin and right-handed unit axes, in mm.
type frame = { origin: Vec3.t, x: Vec3.t, y: Vec3.t, z: Vec3.t }
/// A frame at `origin` with z along `zAxis` and x along the part of `xAxis`
/// square to it; y completes it. A zero z axis, or an x axis that is zero or
/// parallel to z, is an error.
let frame : (Vec3.t, Vec3.t, Vec3.t) => frame
/// Move a solid into a frame: its X, Y and Z axes turn onto the frame's and
/// its origin moves to the frame's origin — one step instead of a chain of
/// rotations and a move. Build the frame with `frame`.
let place : (frame, t) => t

/// Round the outside edge where a solid's flat faces on planes `faceA` and
/// `faceB` meet, to `radius` mm. Give each plane with its normal pointing
/// into the solid — planes that would `trim` it unchanged; one pointing out
/// cuts nothing, or a sliver. The whole line where the planes meet is cut,
/// wherever it runs through the solid. Chain calls for more edges: rounds and
/// bevels that meet at a corner overlap cleanly at any sizes, equal ones too.
/// The round stands 0.05 mm proud of a true one, so it meets each face at a
/// slight crease instead of grazing it (a graze leaves slivers that won't
/// export); a round too small to reach past that is an error. Like a boolean,
/// evaluated once at its own scale: round parts at final size.
///
/// ```
/// // A 40 × 30 × 20 block (bottom z = -10, left side x = -20), its
/// // bottom-left edge rounded.
/// let bottom = { normal: Vec3.make(0.0, 0.0, 1.0), offset: -10.0 }
/// let left = { normal: Vec3.make(1.0, 0.0, 0.0), offset: -20.0 }
/// let part = Solid.box(40.0, 30.0, 20.0) |> Solid.roundEdge(3.0, bottom, left)
/// ```
let roundEdge : (float, plane, plane, t) => t
/// Bevel the outside edge where a solid's flat faces on planes `faceA` and
/// `faceB` meet, cut back `distance` mm along each face; planes as for
/// `roundEdge`.
let bevelEdge : (float, plane, plane, t) => t

/// Place solids together as one part (at least one). Pieces are NOT merged —
/// each stays its own closed shell, which slicers print as a union — so they
/// must overlap or stay apart: pieces whose corners or edges land on the same
/// point (stacked equal-radius rings, boxes meeting edge to edge) won't export.
/// Use `union` to fuse pieces into one solid.
let group : (List<t>) => t

/// Show a solid in a scene at true size: millimetres become metres and Z-up
/// becomes Y-up, so a 40 mm part is 0.04 world units tall. Style it like any
/// scene (`|> Scene.lit(color)`). Build the solid once (a top-level `let`), not
/// inside `draw`: its mesh is cached per solid value.
let toScene : (t) => Scene.t

/// The enclosed volume in cubic millimetres: the sum of a group's pieces, so
/// overlaps count twice.
let volume : (t) => float
/// The bounding box of the exported mesh.
let bounds : (t) => bounds
/// Whether `functor export` would write a solid: `ok`, or the reasons it
/// refuses it (pieces touching exactly at an edge or corner, an empty or open
/// mesh, a failed boolean). `expect Solid.check(part).problems == []` shows
/// them when a test fails. Parts exported together as one `.stl` must also
/// pass together: `Solid.check(Solid.group([a, b]))`.
type check = { ok: bool, problems: List<string> }
/// Run export's checks on a solid, without exporting it.
let check : (t) => check
/// Options for `fromMesh`: the printed height and the nozzle width, in mm.
type printOptions = { height: float, nozzle: float }
/// A printable solid from any mesh — open, self-intersecting or paper-thin is
/// fine: scaled so it is `height` mm tall, closed, and every surface thickened
/// to the nozzle width. Remeshing takes a moment for big meshes (and reruns on
/// reload); bind it once at the top level, and use `functor export --model` for
/// the finest detail on big ones.
let fromMesh : (printOptions, Mesh.t) => t
