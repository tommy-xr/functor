//! Typefaces for `Sketch.text`: two built in (subsets of SIL Open Font
//! License fonts covering one line of Latin-1 text, identical on every
//! target), or any TrueType/OpenType file in the project.

/// An opaque typeface.
type t = host

/// A readable semi-cursive script (derived from Courgette, OFL).
let script : () => t
/// A clean sans-serif (derived from Lato, OFL).
let sans : () => t
/// A TrueType or OpenType font file, relative to the entry file's folder:
/// `Typeface.file("fonts/MyScript.ttf")`. It is read on each call, so bind it
/// once at the top level, not in `draw`. Desktop, `functor export` and Quest;
/// not the web yet.
impure[file]
let file : (string) => t
