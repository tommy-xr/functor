# pan.input — sweep the flashlight across the props and back; frame 120's
# view equals frame 0's, so frames 5..120 loop. (Frame 0 renders before the
# first physics step, so it has no props yet.)
#
#   functor -d examples/night-terrain run native \
#     --input-script "$PWD/examples/night-terrain/pan.input" \
#     --script-dt 0.0166667 --capture-frame /tmp/f.png --capture-at-frame 60
0 Mouse.Move 0 0
2 Mouse.Move 12 0
4 Mouse.Move 24 0
