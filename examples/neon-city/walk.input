# walk.input — a slow walk up the central avenue with a gentle pan, then a
# lift-off to the overview. Drives the PR GIF; deterministic under --script-dt.
#
#   functor -d examples/neon-city run native --input-script walk.input \
#     --script-dt 0.0166667 --capture-at-frame 120 --capture-frame /tmp/walk.png
#
#   f 0..   anchor the pointer, then walk north (W)
#   f 20..  pan right, then back left past centre
#   f 240   Space: rise to the overview
0 Mouse.Move 640 400
10 W down
