# colormap.input — the baked colormap shading, day → night.
#
#   functor -d examples/terrain run native -- --input-script colormap.input \
#     --capture-frame /tmp/f.png --capture-at-frame 180 --capture-size 1600x1200
#
#   f 10    C: switch to the colormap   (golden at 180: day)
#   f 200   N: night; the 2 s cross-fade is half done at 260 (golden: dusk)
#           and complete by 320         (golden at 400: night)
10 C down
11 C up
200 N down
201 N up
