# flashlight.input — the colormap at night, lit only by the flashlight.
#
#   functor -d examples/terrain run native -- --input-script flashlight.input \
#     --capture-frame /tmp/f.png --capture-at-frame 400 --capture-size 1600x1200
#
#   f 10    C: switch to the colormap
#   f 200   N: night (cross-fade complete by 320)
#   f 300   L: flashlight on; turn toward the valley and look down
#           (golden at 400)
10 C down
11 C up
200 N down
201 N up
300 L down
301 L up
300 Mouse.Move 400 300
301 Mouse.Move 640 345
